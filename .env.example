# 复制本文件为 .env 后填写（不要把填好的 .env 上传 GitHub）
# copy .env.example .env

PRIVATE_KEY=填你的MetaMask私钥
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=填你的Etherscan_API_Key可选
OWNERS=填Owner1地址,填Owner2地址,填Owner3地址
GUARDIANS=填Guardian地址建议与Owner1相同
SMALL_THRESHOLD=2
LARGE_THRESHOLD=3
LARGE_AMOUNT_THRESHOLD=100000000000000000
COOLDOWN_PERIOD=120
OWNER2_PRIVATE_KEY=填Owner2的MetaMask私钥可选
